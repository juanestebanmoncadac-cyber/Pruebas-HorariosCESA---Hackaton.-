# Copia este archivo como .env.local (no se sube a git) y llena la llave.
# Cualquier API compatible con OpenAI sirve.

# Opción A — OpenRouter (modelos abiertos en la nube): crea la llave en https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
# Otros modelos abiertos: moonshotai/kimi-k2 · qwen/qwen3-235b-a22b · google/gemma-3-27b-it

# Opción B — Ollama en tu computador (gratis, sin llave): `ollama pull qwen3` y luego
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3
